{"caseId": "sci-019", "material": {"title": "Quantum computing’s “dark horse” just proved it can go universal", "originalTitle": null, "publishedAt": "2026-09-25T12:45:04+00:00", "sourceName": "ScienceDaily · AI", "bodyZh": null, "bodyOriginal": "Researchers have shown that exotic quantum particles called non-Abelian anyons can perform the full range of operations needed for universal quantum computing. Using 54 qubits on Quantinuum’s H2 processor, they combined braiding and fusion to unlock capabilities that braiding alone could not provide."}, "sourceFacts": {"sourceKind": "rss", "sourceTier": "T2", "firstParty": false, "language": "en"}, "samplingContext": {"benchmarkSplit": "development", "samplingStratum": "前沿"}, "gold": {"decision": "reject"}}
{"caseId": "sci-020", "material": {"title": "MIT’s tiny flying robot gets 450% faster with AI", "originalTitle": null, "publishedAt": "2026-09-22T12:52:43+00:00", "sourceName": "ScienceDaily · AI", "bodyZh": null, "bodyOriginal": "A new AI control system lets MIT’s tiny flying robot move with insect-like agility, boosting its speed by about 450 percent and allowing it to pull off 10 somersaults in 11 seconds. The technology could eventually enable miniature robots to search earthquake rubble and navigate dangerous spaces that conventional drones cannot reach."}, "sourceFacts": {"sourceKind": "rss", "sourceTier": "T2", "firstParty": false, "language": "en"}, "samplingContext": {"benchmarkSplit": "development", "samplingStratum": "前沿"}, "gold": {"decision": "select"}}
{"caseId": "sci-022", "material": {"title": "AI uncovers hidden Ozempic side effects across 400,000 Reddit posts", "originalTitle": null, "publishedAt": "2026-09-13T10:46:19+00:00", "sourceName": "ScienceDaily · AI", "bodyZh": null, "bodyOriginal": "AI analysis of 400,000 Reddit posts found that users of drugs such as Ozempic, Wegovy, Mounjaro, and Zepbound reported unexpected symptoms including menstrual changes, chills, hot flashes, and fatigue. Researchers cannot say the medications caused these problems, but the patterns may reveal overlooked signals worth studying."}, "sourceFacts": {"sourceKind": "rss", "sourceTier": "T2", "firstParty": false, "language": "en"}, "samplingContext": {"benchmarkSplit": "development", "samplingStratum": "前沿"}, "gold": {"decision": "select"}}
{"caseId": "sci-023", "material": {"title": "OpenAI agent hacked an Australian government healthcare website", "originalTitle": null, "publishedAt": "2026-09-24T08:26:15+00:00", "sourceName": "New Scientist · 科技", "bodyZh": null, "bodyOriginal": "OpenAI CEO Sam Altman spoke to the Australian prime minister, Anthony Albanese, about the hack while attending the United Nations General Assembly in New York Selcuk Acar/Anadolu via Getty Images Australia’s national health website has been hacked by an OpenAI agent. It was able to access non-public files and is the first publicly revealed case of an AI agent breaching the defences of a government portal. Full details of the hack haven’t yet been revealed. But the essence of the incident, as outlined by Prime Minister Anthony Albanese , who is in New York for the United Nations General Assembl"}, "sourceFacts": {"sourceKind": "rss", "sourceTier": "T2", "firstParty": false, "language": "en"}, "samplingContext": {"benchmarkSplit": "holdout", "samplingStratum": "前沿"}, "gold": {"decision": "reject"}}
